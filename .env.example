# 이 파일을 .env.local로 복사한 뒤 값을 입력합니다. 실제 값은 커밋하지 않습니다.
# 자세한 설정·활성화 절차: README.md의 환경변수 / Discord 슬래시 명령 절

# 데이터베이스
# Postgres 연결 문자열. 로컬에서는 운영 DB와 분리된 DB를 사용합니다.
DATABASE_URL=
# (선택) 마이그레이션용 직접 연결 주소. 없으면 DATABASE_URL을 씁니다.
DATABASE_URL_UNPOOLED=

# Discord — 로그인·채팅 수집·슬래시 명령 모두 같은 앱을 사용합니다.
# General Information → Application ID (공개 정보, 숫자 17~20자리)
DISCORD_CLIENT_ID=
# OAuth2 → Client Secret (로그인용 비밀값, 봇 토큰과 다릅니다)
DISCORD_CLIENT_SECRET=
# 접속을 허용할 Discord 서버 ID (공개 정보, 숫자 17~20자리)
DISCORD_GUILD_ID=
# (선택) General Information → Public Key (공개 정보, 64자리 16진수)
# /게임추천 요청의 서명 검증용. 미설정 시 슬래시 명령 API는 꺼집니다.
DISCORD_PUBLIC_KEY=
# (선택) Bot → Token (비밀값). 채팅 수집·슬래시 명령 등록에 사용합니다.
DISCORD_BOT_TOKEN=
# (선택) 1이면 채팅 웃음 분석(ㅋ 개수)을 켭니다.
# 친구들 동의 후에만, 개발자 포털의 Message Content Intent와 함께 켭니다.
CHAT_LAUGH=

# 로그인 세션 서명용 비밀값 (랜덤 문자열, 32자 이상)
SESSION_SECRET=
# (선택) 1이면 개발 서버에서만 Discord 로그인 없이 관리자로 접속합니다.
# 운영 빌드에서는 무시됩니다.
DEV_LOGIN=

# 게임 API
# Riot API 키 (비밀값, RGAPI-로 시작)
RIOT_API_KEY=
# (선택) Steam 기능용 Web API 키 (비밀값, 32자리 16진수)
STEAM_API_KEY=

# 자동 수집·운영 알림
# (선택) 크론 인증 비밀값 (랜덤 문자열, 16자 이상)
CRON_SECRET=
# (선택) 운영 장애·복구 알림 전용 Discord webhook URL. URL의 토큰은 비밀값으로 취급
OPS_ALERT_WEBHOOK_URL=
