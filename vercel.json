{
  "framework": "nextjs",
  "ignoreCommand": "[ -n \"$VERCEL_GIT_COMMIT_REF\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "buildCommand": "node scripts/migrate.mjs && next build",
  "crons": [
    {
      "path": "/api/cron/ops-watchdog",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/chat",
      "schedule": "0 19 * * *"
    }
  ]
}
